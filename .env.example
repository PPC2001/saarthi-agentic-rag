# ══════════════════════════════════════════════════════════════════════════════
#  Saarthi AI · Environment Configuration Template
#
#  RULE: The exact same set of keys is used for both DEV and PROD.
#  Only the values differ between environments.
#  Models, providers, S3 buckets, DynamoDB prefixes, and Secrets Manager paths
#  are auto-resolved based on ENV in src/app/config.py.
# ══════════════════════════════════════════════════════════════════════════════

# ── Runtime Environment ───────────────────────────────────────────────────────
ENV=DEV                                      # DEV | PROD

# ── Portkey AI Gateway ────────────────────────────────────────────────────────
PORTKEY_API_KEY=                             # * Portkey account API key (same account for both)
PORTKEY_VIRTUAL_KEY=groq-vk-dev              # DEV: groq-vk-dev | PROD: bedrock-vk-prod
PORTKEY_BASE_URL=https://api.portkey.ai/v1   # Portkey base URL

# ── AWS Core & Storage (S3) ───────────────────────────────────────────────────
AWS_REGION=ap-south-1                        # DEV: ap-south-1 | PROD: ap-south-1 (Mumbai)

# ── Qdrant Vector DB ──────────────────────────────────────────────────────────
QDRANT_URL=                                  # * DEV: dev-cluster URL | PROD: prod-cluster URL
QDRANT_API_KEY=                              # * DEV: dev API key     | PROD: prod API key

# ── Redis Semantic Cache ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0           # DEV: local/Upstash | PROD: ElastiCache endpoint

# ── Observability ─────────────────────────────────────────────────────────────
LOGFIRE_TOKEN=                               # * Pydantic Logfire write token (pylf_v1_...)

# ── Authentication ────────────────────────────────────────────────────────────
DEV_API_KEY=dev-test-key-12345               # DEV: dev-test-key-12345 | PROD: (leave empty)
