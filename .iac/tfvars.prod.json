{
  "aws_region": "us-east-1",
  "account_id": "<PLACEHOLDER: 12-digit AWS Account ID, e.g. 987654321098>",
  "environment_name": "PROD",
  "service_name": "saarthi-ai",
  "git_commit_hash": "<PLACEHOLDER: Production Git SHA, e.g. a1b2c3d4e5f6>",
  "git_tag_name": "v1.0.0",
  "vpc_id": "<PLACEHOLDER: Production VPC ID, e.g. vpc-0987654321fedcba0>",
  "private_subnet_ids": [
    "<PLACEHOLDER: Private Subnet 1A, e.g. subnet-05555555555555555>",
    "<PLACEHOLDER: Private Subnet 1B, e.g. subnet-06666666666666666>",
    "<PLACEHOLDER: Private Subnet 1C, e.g. subnet-07777777777777777>"
  ],
  "public_subnet_ids": [
    "<PLACEHOLDER: Public Subnet 1A for ALB, e.g. subnet-08888888888888888>",
    "<PLACEHOLDER: Public Subnet 1B for ALB, e.g. subnet-09999999999999999>",
    "<PLACEHOLDER: Public Subnet 1C for ALB, e.g. subnet-0aaaaaaaaaaaaaaaa>"
  ],
  "container_port": 8000,
  "container_image": "",
  "certificate_arn": "arn:aws:acm:<REGION>:<ACCOUNT_ID>:certificate/<PLACEHOLDER: ACM_CERTIFICATE_UUID>",
  "task_definition": {
    "cpu": 2048,
    "memory": 4096,
    "environments": {
      "ENVIRONMENT": "production",
      "LOG_LEVEL": "INFO",
      "PORT": "8000",
      "QDRANT_HOST": "<PLACEHOLDER: Production Qdrant endpoint, e.g. https://qdrant-prod.internal:6333>",
      "CORS_ORIGINS": "<PLACEHOLDER: Allowed web domain, e.g. https://saarthi.yourdomain.com>"
    },
    "secrets": {
      "LOGFIRE_TOKEN": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:saarthi-ai/prod/logfire-token",
      "QWEN_API_KEY": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:saarthi-ai/prod/qwen-api-key",
      "TAVILY_API_KEY": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:saarthi-ai/prod/tavily-api-key",
      "QDRANT_API_KEY": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:saarthi-ai/prod/qdrant-api-key",
      "SECRET_KEY": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:saarthi-ai/prod/session-secret"
    }
  },
  "service": {
    "min_capacity": 2,
    "desired_count": 3,
    "max_capacity": 10
  },
  "tags": {
    "Project": "Saarthi-AI",
    "Environment": "PROD",
    "Tier": "Tier-1-Mission-Critical",
    "Owner": "Insurance-Tech",
    "ManagedBy": "Terraform"
  }
}
